---
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro'; import PageIntro from '../../components/editorial/PageIntro.astro'; import ArchiveCollection from '../../components/discovery/ArchiveCollection.astro'; import Portrait from '../../components/media/Portrait.astro'; import JornalConcretoLayout from '../../layouts/JornalConcretoLayout.astro'; import { authors, editorialSite } from '../../lib/presentation/site-repository'; import { archiveEntriesForAuthor } from '../../lib/presentation/archive-repository'; import { navigationFor } from '../../lib/presentation/editorial-site';
export function getStaticPaths(){return authors.map((author)=>({params:{slug:author.slug},props:{author}}));} const {author}=Astro.props; const entries=archiveEntriesForAuthor(author.slug);
---
<JornalConcretoLayout title={author.nickname} description={author.role} dateLabel={editorialSite.site.dateLabel} navigation={navigationFor(`/redacao/${author.slug}/`)} canonicalPath={`/redacao/${author.slug}/`}><main id="conteudo"><Breadcrumbs items={[{label:'Início',href:'/'},{label:'A Redação',href:'/a-redacao/'},{label:'Diretório',href:'/redacao/'},author.nickname]} /><div class="author-profile"><Portrait portrait={author.portrait} nickname={author.nickname} size="profile" showCredit={true}/><PageIntro eyebrow={author.department} title={author.nickname} summary={author.role} detail={author.blog?`Blog: ${author.blog}`:author.role_type==='editor'?'Editor responsável':'Jornalista'} /></div><section class="profile-note"><h2>Perfil editorial</h2><p>Função, departamento e arquivo de publicações vinculadas.</p>{!author.portrait&&author.role_type==='editor'&&<p class="media-status">Retrato editorial aguardando ativo aprovado. O portal mantém placeholder tipográfico, sem imagem genérica.</p>}</section>{entries.length?<ArchiveCollection entries={entries}/>:<section class="empty-state"><h2>Sem assinatura no acervo atual</h2></section>}</main></JornalConcretoLayout>
