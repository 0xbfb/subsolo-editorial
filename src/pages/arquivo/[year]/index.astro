---
import Breadcrumbs from '../../../components/navigation/Breadcrumbs.astro'; import PageIntro from '../../../components/editorial/PageIntro.astro'; import ArchiveCollection from '../../../components/discovery/ArchiveCollection.astro'; import JornalConcretoLayout from '../../../layouts/JornalConcretoLayout.astro'; import { editorialSite } from '../../../lib/presentation/site-repository'; import { discoveryDates, archiveEntriesForDate } from '../../../lib/presentation/archive-repository'; import { navigationFor } from '../../../lib/presentation/editorial-site';
export function getStaticPaths(){return discoveryDates.years.map((year)=>({params:{year},props:{year}}));} const {year}=Astro.props; const entries=archiveEntriesForDate(year);
---
<JornalConcretoLayout title={`Arquivo ${year}`} description={`Publicações de ${year}.`} dateLabel={editorialSite.site.dateLabel} navigation={navigationFor('/arquivo/')} canonicalPath={`/arquivo/${year}/`}><main id="conteudo"><Breadcrumbs items={[{label:'Início',href:'/'},{label:'Arquivo',href:'/arquivo/'},year]} /><PageIntro eyebrow="Arquivo anual" title={year} summary={`${entries.length} registros preservados.`} /><ArchiveCollection entries={entries} /></main></JornalConcretoLayout>
