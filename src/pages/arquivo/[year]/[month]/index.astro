---
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro'; import PageIntro from '../../../../components/editorial/PageIntro.astro'; import ArchiveCollection from '../../../../components/discovery/ArchiveCollection.astro'; import JornalConcretoLayout from '../../../../layouts/JornalConcretoLayout.astro'; import { editorialSite } from '../../../../lib/presentation/site-repository'; import { discoveryDates, archiveEntriesForDate } from '../../../../lib/presentation/archive-repository'; import { navigationFor } from '../../../../lib/presentation/editorial-site';
export function getStaticPaths(){return discoveryDates.months.map((value)=>{const [year,month]=value.split('-');return{params:{year,month},props:{year,month}}});} const {year,month}=Astro.props; const entries=archiveEntriesForDate(year,month);
---
<JornalConcretoLayout title={`Arquivo ${month}/${year}`} description={`Publicações de ${month}/${year}.`} dateLabel={editorialSite.site.dateLabel} navigation={navigationFor('/arquivo/')} canonicalPath={`/arquivo/${year}/${month}/`}><main id="conteudo"><Breadcrumbs items={[{label:'Início',href:'/'},{label:'Arquivo',href:'/arquivo/'},{label:year,href:`/arquivo/${year}/`},month]} /><PageIntro eyebrow="Arquivo mensal" title={`${month}/${year}`} summary={`${entries.length} registros preservados.`} /><ArchiveCollection entries={entries} /></main></JornalConcretoLayout>
