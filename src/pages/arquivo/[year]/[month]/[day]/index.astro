---
import Breadcrumbs from '../../../../../components/navigation/Breadcrumbs.astro'; import PageIntro from '../../../../../components/editorial/PageIntro.astro'; import ArchiveCollection from '../../../../../components/discovery/ArchiveCollection.astro'; import JornalConcretoLayout from '../../../../../layouts/JornalConcretoLayout.astro'; import { editorialSite } from '../../../../../lib/presentation/site-repository'; import { discoveryDates, archiveEntriesForDate } from '../../../../../lib/presentation/archive-repository'; import { navigationFor } from '../../../../../lib/presentation/editorial-site';
export function getStaticPaths(){return discoveryDates.days.map((value)=>{const [year,month,day]=value.split('-');return{params:{year,month,day},props:{year,month,day}}});} const {year,month,day}=Astro.props; const entries=archiveEntriesForDate(year,month,day);
---
<JornalConcretoLayout title={`Arquivo ${day}/${month}/${year}`} description={`Publicações de ${day}/${month}/${year}.`} dateLabel={editorialSite.site.dateLabel} navigation={navigationFor('/arquivo/')} canonicalPath={`/arquivo/${year}/${month}/${day}/`}><main id="conteudo"><Breadcrumbs items={[{label:'Início',href:'/'},{label:'Arquivo',href:'/arquivo/'},{label:year,href:`/arquivo/${year}/`},{label:month,href:`/arquivo/${year}/${month}/`},day]} /><PageIntro eyebrow="Arquivo diário" title={`${day}/${month}/${year}`} summary={`${entries.length} registros preservados.`} /><ArchiveCollection entries={entries} /></main></JornalConcretoLayout>
