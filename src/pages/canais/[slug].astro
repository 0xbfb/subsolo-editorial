---
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro'; import PageIntro from '../../components/editorial/PageIntro.astro'; import SectionRule from '../../components/editorial/SectionRule.astro'; import ArchiveCollection from '../../components/discovery/ArchiveCollection.astro'; import JornalConcretoLayout from '../../layouts/JornalConcretoLayout.astro'; import { channels, frames, editorialSite, authorNames } from '../../lib/presentation/site-repository'; import { archiveEntriesForChannel } from '../../lib/presentation/archive-repository'; import { navigationFor } from '../../lib/presentation/editorial-site';
export function getStaticPaths(){return channels.map((channel)=>({params:{slug:channel.slug},props:{channel}}));} const {channel}=Astro.props; const entries=archiveEntriesForChannel(channel.slug); const channelFrames=frames.filter((frame)=>frame.channel_id===channel.channel_id);
---
<JornalConcretoLayout title={channel.name} description={channel.function} dateLabel={editorialSite.site.dateLabel} navigation={navigationFor(`/canais/${channel.slug}/`)} canonicalPath={`/canais/${channel.slug}/`}><main id="conteudo"><Breadcrumbs items={[{label:'Início',href:'/'},{label:'Canais',href:'/canais/'},channel.name]} /><PageIntro eyebrow={`Canal editorial · ${channel.periodicity}`} title={channel.name} summary={channel.function} detail={`Editoria: ${authorNames[channel.editor_id.replace('redacao011-','')]??channel.editor_id}`} /><section class="channel-question"><div class="kicker">Pergunta editorial</div><p class="lead">{channel.question}</p></section><SectionRule label="Arquivo do canal" detail={`${entries.length} registros`} />{entries.length?<ArchiveCollection entries={entries}/>:<section class="empty-state"><h2>Arquivo em formação</h2></section>}<SectionRule label="Quadros do canal" detail={`${channelFrames.length} formatos`} light/><section class="frame-grid">{channelFrames.map((frame)=><article><h3>{frame.name}</h3><p>{frame.description}</p><span class="meta">{frame.required?'Estrutura recorrente':'Usado quando houver pauta'}</span></article>)}</section></main></JornalConcretoLayout>
