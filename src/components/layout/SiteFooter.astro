---
import { withBasePath } from '../../lib/presentation/site-path';
const links = [
  { label: 'A Redação', href: '/a-redacao/' },
  { label: 'Canais', href: '/canais/' },
  { label: 'Arquivo', href: '/arquivo/' },
  { label: 'Busca', href: '/busca/' },
  { label: 'Documentos', href: '/documentos/relatorio-operacional/' },
  { label: 'Privacidade', href: '/privacidade/' },
];
---
<footer class="footer">
  <div class="footer-links">
    {links.map((item) => <a href={withBasePath(item.href, import.meta.env.BASE_URL)}>{item.label}</a>)}
  </div>
  SUBSOLO EDITORIAL · O RUÍDO PASSA. O QUE IMPORTA FICA.
</footer>
