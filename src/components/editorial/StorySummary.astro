---
import { withBasePath } from '../../lib/presentation/site-path';
interface Props {
  readonly channel: string;
  readonly title: string;
  readonly summary: string;
  readonly compact?: boolean;
  readonly href?: string;
}
const { channel, title, summary, compact = false, href } = Astro.props;
const publicHref = href ? withBasePath(href, import.meta.env.BASE_URL) : undefined;
---
<article class={compact ? undefined : 'news-card'}>
  <div class="kicker">{channel}</div>
  <h2>
    {publicHref ? <a class="story-title-link" href={publicHref}><span class="story-title">{title}</span></a> : <span class="story-title">{title}</span>}
  </h2>
  <p>{summary}</p>
</article>
