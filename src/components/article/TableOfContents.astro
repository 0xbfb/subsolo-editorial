---
interface Props { readonly items: readonly (readonly [string, string])[]; }
const { items } = Astro.props;
---
<nav class="article-toc" aria-label="Sumário da matéria">
  <div class="kicker">Nesta publicação</div>
  <ol>
    {items.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
  </ol>
</nav>
