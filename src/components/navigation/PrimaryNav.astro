---
import type { NavigationItem } from '../../lib/presentation/home-page';
import { withBasePath } from '../../lib/presentation/site-path';

interface Props {
  readonly items: readonly NavigationItem[];
}

const { items } = Astro.props;
---
<nav aria-label="Navegação principal" class="primary-nav">
  {items.map((item) => item.available ? (
    <a aria-current={item.current ? 'page' : undefined} href={withBasePath(item.href, import.meta.env.BASE_URL)}>{item.label}</a>
  ) : (
    <span aria-disabled="true">{item.label}</span>
  ))}
</nav>
