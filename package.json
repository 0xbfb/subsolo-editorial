{
  "name": "subsolo",
  "version": "1.0.0-pre",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=11.15.0 <12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --output-subdir pagefind",
    "preview": "astro preview",
    "lint": "eslint . && node scripts/check-boundaries.mjs && node scripts/verify-source-manifest.mjs",
    "typecheck": "astro sync && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:hardening && pnpm build && pnpm hardening:artifact && pnpm test:scale && pnpm format:check",
    "verify:sources": "node scripts/verify-source-manifest.mjs",
    "verify:boundaries": "node scripts/check-boundaries.mjs",
    "infra:validate": "node scripts/validate-infra.mjs",
    "infra:config": "bash infra/scripts/config.sh",
    "infra:start": "bash infra/scripts/start.sh --apply",
    "infra:stop": "bash infra/scripts/stop.sh --apply",
    "infra:health": "bash infra/scripts/healthcheck.sh",
    "infra:backup:dry-run": "bash infra/scripts/backup.sh --dry-run",
    "infra:restore:dry-run": "bash infra/scripts/restore.sh --dry-run",
    "test:infra": "node --test tests/infra/*.test.mjs",
    "test:domain": "vitest run tests/domain tests/application",
    "test:editorial": "node --test tests/editorial/*.test.mjs",
    "validate:fixtures": "node scripts/validate-editorial-fixtures.mjs",
    "generate:editorial-templates": "node scripts/generate-editorial-bootstrap.mjs",
    "test:contract": "vitest run tests/contract",
    "test:contract:static": "node --test tests/contract/*.test.mjs && node scripts/validate-public-contracts.mjs",
    "validate:public-content": "node scripts/validate-public-content.mjs",
    "prebuild": "node scripts/validate-editorial-site.mjs && node scripts/validate-public-content.mjs && node scripts/validate-public-media-if-present.mjs && node scripts/generate-discovery-assets.mjs && node scripts/audit-security.mjs && node scripts/check-a11y.mjs",
    "test:visual:static": "node --test tests/visual/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "render:design-preview": "node scripts/render-design-preview.mjs",
    "validate:editorial-site": "node scripts/validate-editorial-site.mjs",
    "render:editorial-preview": "node scripts/render-editorial-preview.mjs",
    "validate:preview-links": "node scripts/validate-preview-links.mjs",
    "test:routes:static": "node --test tests/visual/editorial-routes-static.test.mjs tests/contract/editorial-site-static.test.mjs",
    "ci:local": "node scripts/ci-local.mjs",
    "verify:workflows": "node scripts/verify-workflows.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "scan:public-artifact": "node scripts/scan-public-artifact.mjs",
    "smoke:site": "node scripts/smoke-site.mjs",
    "test:deployment:static": "node --test tests/deployment/*.test.mjs",
    "check:release": "node scripts/verify-workflows.mjs && node scripts/validate-editorial-site.mjs && node scripts/validate-public-content.mjs && node scripts/audit-security.mjs && node scripts/check-a11y.mjs",
    "cli": "node cli/subsolo.mjs",
    "export:fixture:dry-run": "node cli/subsolo.mjs export-doc --sheet fixtures/exporter/valid/sheet-row.json --document fixtures/exporter/valid/document.json --destination .tmp/exported-publication --dry-run",
    "test:exporter": "node --test tests/exporter/*.test.mjs",
    "test:google": "node --test tests/google/*.test.mjs",
    "test:integration": "node --test tests/google/*.test.mjs",
    "test:packager": "node --test tests/packager/*.test.mjs",
    "package:fixture:dry-run": "node cli/subsolo.mjs package --workspace fixtures/packager/edition-r1 --destination .tmp/packages --dry-run",
    "validate:package": "node cli/subsolo.mjs validate-package",
    "test:drive": "node --test tests/drive/*.test.mjs",
    "archive:fixture:dry-run": "node cli/subsolo.mjs publish --package fixtures/packager/golden/r1.zip --drive-root-id \"$SUBSOLO_DRIVE_ROOT_FOLDER_ID\" --skip-git --dry-run",
    "test:n8n": "node --test tests/n8n/*.test.mjs",
    "orchestrate:fixture:dry-run": "node cli/subsolo.mjs orchestrate --input fixtures/n8n/publication-candidate.json --dry-run",
    "reconcile:fixture:dry-run": "node cli/subsolo.mjs reconcile --input fixtures/n8n/reconciliation-candidate.json --dry-run",
    "test:edition-lifecycle": "node --test tests/edition-lifecycle/*.test.mjs",
    "edition:open:dry-run": "node cli/subsolo.mjs edition --command open --state fixtures/edition-lifecycle/private/edition-state.json --payload fixtures/edition-lifecycle/private/open.json --output .tmp/edition-open.json --dry-run",
    "pagefind": "pagefind --site dist --output-subdir pagefind",
    "generate:discovery": "node scripts/generate-discovery-assets.mjs",
    "test:discovery": "node --test tests/discovery.test.mjs tests/discovery-static.test.mjs",
    "validate:feeds": "node scripts/validate-discovery-assets.mjs",
    "test:ingestion": "node --test tests/ingestion/*.test.mjs tests/n8n/workflows-static.test.mjs",
    "ingest:freshrss:fixture": "node cli/subsolo.mjs ingest --source freshrss --provider fixture --input fixtures/ingestion/freshrss.json --state .runtime/editorial/pitches.json --output .runtime/reports/freshrss --dry-run",
    "test:post-publication": "node --test tests/post-publication/*.test.mjs",
    "post-publication:correction:dry-run": "node cli/subsolo.mjs post-publication --state fixtures/post-publication/state.json --payload fixtures/post-publication/correction.json --output .tmp/post-publication-state.json --dry-run",
    "process:media": "node cli/subsolo.mjs media",
    "process:media:dry-run": "node cli/subsolo.mjs media --manifest fixtures/media/portrait/manifest.json --destination .tmp/media-output --dry-run",
    "test:media": "node --test tests/media/*.test.mjs",
    "validate:media": "node scripts/validate-media-assets.mjs",
    "validate:media:public": "node scripts/validate-public-media-if-present.mjs",
    "test:observability": "node --test tests/observability/*.test.mjs",
    "validate:observability": "node scripts/validate-observability.mjs",
    "reconcile:operations:dry-run": "node cli/subsolo.mjs reconcile --input fixtures/observability/reconciliation-diverged.json --dry-run",
    "infra:backup:apply": "bash infra/scripts/backup.sh --apply",
    "infra:restore:test": "bash infra/scripts/restore.sh --test",
    "infra:alert:dry-run": "bash infra/scripts/alert.sh --severity warning --code TEST_ALERT --action \"Nenhuma ação; teste local.\" --dry-run",
    "audit:security": "node scripts/audit-security.mjs",
    "scan:secrets": "node scripts/scan-repository-secrets.mjs",
    "check:headers": "node scripts/check-security-headers.mjs",
    "check:permissions": "node scripts/check-minimum-permissions.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:performance": "node scripts/check-performance.mjs",
    "test:scale": "node scripts/test-scale.mjs",
    "test:degraded": "node scripts/check-degraded-modes.mjs",
    "test:hardening": "node --test tests/hardening/*.test.mjs",
    "hardening:prebuild": "pnpm audit:security && pnpm check:headers && pnpm check:permissions && pnpm check:a11y",
    "hardening:artifact": "pnpm check:performance && pnpm test:degraded && pnpm scan:public-artifact",
    "test:all": "node scripts/test-all.mjs",
    "release:fixture-flow": "node scripts/release-fixture-flow.mjs",
    "release:sbom": "node scripts/generate-sbom.mjs",
    "release:inventory": "node scripts/generate-release-inventory.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "release:verify:offline": "node scripts/release-verify.mjs --allow-blockers --report reports/prompt-20/release-verification.json"
  },
  "dependencies": {
    "astro": "7.1.2"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "eslint": "10.7.0",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.57.0",
    "pagefind": "1.5.2"
  }
}
