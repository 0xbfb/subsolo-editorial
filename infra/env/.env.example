# Copie para infra/env/.env e troque todos os valores CHANGEME.
COMPOSE_PROJECT_NAME=subsolo
SUBSOLO_TIMEZONE=America/Sao_Paulo

POSTGRES_DB=subsolo_n8n
POSTGRES_USER=subsolo_n8n
POSTGRES_PASSWORD=CHANGEME-use-a-long-random-password

N8N_ENCRYPTION_KEY=CHANGEME-use-at-least-32-random-characters
N8N_HOST_PORT=5678
N8N_EXECUTIONS_MAX_AGE_HOURS=336

FRESHRSS_HOST_PORT=8080
FRESHRSS_CRON_MIN=13,43
SEARXNG_HOST_PORT=8081
SEARXNG_SECRET=CHANGEME-use-a-long-random-secret
UPTIME_KUMA_HOST_PORT=3001
NTFY_HOST_PORT=8082

SUBSOLO_BACKUP_DIR=./infra/backups
SUBSOLO_BACKUP_RETENTION_DAYS=14

# Captação editorial. Segredos devem ser trocados e não commitados em infra/env/.env.
SUBSOLO_FRESHRSS_API_URL=http://freshrss/api/greader.php
SUBSOLO_FRESHRSS_API_USER=
SUBSOLO_FRESHRSS_API_PASSWORD=
SUBSOLO_FRESHRSS_AUTH_TOKEN=
SUBSOLO_SEARXNG_URL=http://searxng:8080
SUBSOLO_GMAIL_READONLY_TOKEN=
SUBSOLO_GMAIL_QUERY=label:SUBSOLO/Pautas newer_than:2d
SUBSOLO_GOOGLE_SPREADSHEET_ID=
SUBSOLO_GOOGLE_SHEETS_WRITE_ACCESS_TOKEN=
SUBSOLO_INGESTION_POLICY_FILE=/workspace/.runtime/config/ingestion-policy.json
SUBSOLO_INGESTION_STATE=/workspace/.runtime/editorial/pitches.json

# Observabilidade e recuperação
SUBSOLO_PUBLIC_URL=
SUBSOLO_NTFY_URL=http://127.0.0.1:8082
SUBSOLO_NTFY_TOPIC=
SUBSOLO_NTFY_TOKEN=
# Arquivo fora do repositório, chmod 600, usado pelo OpenSSL PBKDF2.
SUBSOLO_BACKUP_PASSPHRASE_FILE=
SUBSOLO_BACKUP_RETENTION_DAYS=14
