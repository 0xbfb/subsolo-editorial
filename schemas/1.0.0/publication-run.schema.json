{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subsolo.invalid/schemas/1.0.0/publication-run.schema.json",
  "title": "Subsolo Publication Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "edition_id",
    "revision",
    "state",
    "generated_at",
    "source_workspace_sha256",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "pattern": "^run_\\d{8}T\\d{6}[+-]\\d{4}_r[1-9]\\d*$" },
    "edition_id": { "type": "string", "pattern": "^ed_\\d{4}-\\d{2}-\\d{2}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "state": { "const": "packaged" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_workspace_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "issues"],
      "properties": { "status": { "const": "passed" }, "issues": { "const": 0 } }
    }
  }
}
