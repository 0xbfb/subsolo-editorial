{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subsolo.invalid/schemas/1.0.0/public-topic.schema.json",
  "title": "Public Topic",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "slug", "description", "status"],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 96
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 96
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["ativo", "arquivado"]
    }
  }
}
