{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subsolo.invalid/schemas/1.0.0/public-story.schema.json",
  "title": "Public Story",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "slug",
    "title",
    "status",
    "summary",
    "started_at",
    "topics",
    "actors",
    "next_expected_event"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^story_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 96
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["aberta", "monitoramento", "concluida", "arquivada"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date"
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 96
      }
    },
    "actors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_expected_event": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
