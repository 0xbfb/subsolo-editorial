{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subsolo.invalid/schemas/1.0.0/public-redirect.schema.json",
  "title": "Public Redirect",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "publication_id",
    "from_path",
    "to_path",
    "status_code",
    "effective_at",
    "reason"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^redirect_[0-9A-HJKMNP-TV-Z]{26}$" },
    "publication_id": { "type": "string", "pattern": "^pub_[0-9A-HJKMNP-TV-Z]{26}$" },
    "from_path": {
      "type": "string",
      "pattern": "^/\\d{4}/\\d{2}/\\d{2}/[a-z0-9]+(?:-[a-z0-9]+)*/$"
    },
    "to_path": { "type": "string", "pattern": "^/\\d{4}/\\d{2}/\\d{2}/[a-z0-9]+(?:-[a-z0-9]+)*/$" },
    "status_code": { "const": 308 },
    "effective_at": { "type": "string", "format": "date-time" },
    "reason": { "type": "string", "minLength": 8 }
  }
}
