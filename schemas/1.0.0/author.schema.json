{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subsolo.invalid/schemas/1.0.0/public-author.schema.json",
  "title": "Public Author",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "nickname",
    "slug",
    "role",
    "title",
    "bio",
    "status",
    "portrait"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^author_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "nickname": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 96
    },
    "role": {
      "enum": ["editor", "jornalista", "colunista", "convidado"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "bio": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["ativo", "arquivado"]
    },
    "portrait": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["src", "alt"],
          "properties": {
            "src": {
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
