{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subsolo.invalid/schemas/1.0.0/public-tombstone.schema.json",
  "title": "Public Tombstone",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "publication_id",
    "canonical_path",
    "title",
    "reason",
    "impact",
    "published_at",
    "original_published_at",
    "body_hidden"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^tomb_[0-9A-HJKMNP-TV-Z]{26}$" },
    "publication_id": { "type": "string", "pattern": "^pub_[0-9A-HJKMNP-TV-Z]{26}$" },
    "canonical_path": {
      "type": "string",
      "pattern": "^/\\d{4}/\\d{2}/\\d{2}/[a-z0-9]+(?:-[a-z0-9]+)*/$"
    },
    "title": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 8 },
    "impact": { "type": "string", "minLength": 8 },
    "published_at": { "type": "string", "format": "date-time" },
    "original_published_at": { "type": "string", "format": "date-time" },
    "body_hidden": { "const": true }
  }
}
