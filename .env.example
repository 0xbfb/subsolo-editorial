SUBSOLO_SITE_NAME=SUBSOLO
SUBSOLO_TIMEZONE=America/Sao_Paulo
SUBSOLO_ENV=development
# Segredos da stack local pertencem a infra/env/.env, nunca a este arquivo.

# Google Workspace — leitura somente. Nunca versione o arquivo de credencial.
SUBSOLO_GOOGLE_SPREADSHEET_ID=
SUBSOLO_GOOGLE_SHEETS_RANGE=ARTIGOS!A:AZ
SUBSOLO_GOOGLE_SHEETS_PAGE_SIZE=200
SUBSOLO_GOOGLE_DOCS_TAB_ID=
SUBSOLO_GOOGLE_TIMEOUT_MS=10000
SUBSOLO_GOOGLE_MAX_ATTEMPTS=3
SUBSOLO_GOOGLE_CACHE_TTL_MS=0
# Preferido para operação local reproduzível: conta de serviço compartilhada apenas com os arquivos necessários.
SUBSOLO_GOOGLE_SERVICE_ACCOUNT_FILE=
# Alternativa compatível com Application Default Credentials:
GOOGLE_APPLICATION_CREDENTIALS=
# Apenas para teste manual curto; não grave tokens em .env persistente.
# GOOGLE_WORKSPACE_ACCESS_TOKEN=

# Google Drive — arquivo técnico imutável.
SUBSOLO_DRIVE_ROOT_FOLDER_ID=
SUBSOLO_GOOGLE_DRIVE_TIMEOUT_MS=20000
SUBSOLO_GOOGLE_DRIVE_MAX_ATTEMPTS=4
# Deve ser múltiplo de 262144 bytes.
SUBSOLO_GOOGLE_DRIVE_CHUNK_SIZE=2097152
# Padrão: https://www.googleapis.com/auth/drive.file
# Use o scope completo somente após decisão operacional explícita.
SUBSOLO_GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file
# Token efêmero opcional e separado do token de Docs/Sheets.
# GOOGLE_DRIVE_ACCESS_TOKEN=

# Captação editorial — segredos reais devem permanecer fora do repositório.
SUBSOLO_FRESHRSS_API_URL=http://127.0.0.1:8080/api/greader.php
SUBSOLO_FRESHRSS_API_USER=
# SUBSOLO_FRESHRSS_API_PASSWORD=
SUBSOLO_SEARXNG_URL=http://127.0.0.1:8081
SUBSOLO_GMAIL_QUERY=label:SUBSOLO/Pautas newer_than:2d
# SUBSOLO_GMAIL_READONLY_TOKEN=
# SUBSOLO_GOOGLE_SHEETS_WRITE_ACCESS_TOKEN=
SUBSOLO_INGESTION_POLICY_FILE=.runtime/config/ingestion-policy.json
SUBSOLO_INGESTION_STATE=.runtime/editorial/pitches.json

# Operação e observabilidade
SUBSOLO_PUBLIC_URL=
SUBSOLO_SMOKE_ATTEMPTS=4
SUBSOLO_SMOKE_DELAY_MS=3000
SUBSOLO_SMOKE_TIMEOUT_MS=8000
# Alertas locais; token deve permanecer fora do repositório.
SUBSOLO_NTFY_URL=http://127.0.0.1:8082
SUBSOLO_NTFY_TOPIC=
# SUBSOLO_NTFY_TOKEN=
